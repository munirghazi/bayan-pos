.venv/
**/.venv/
venv/
**/venv/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/

# Node
frontend/node_modules/
frontend/dist/

# Database (contains user data - do not commit)
backend/bayan_pos.db
*.db

# Uploads (product images - user data)
backend/uploads/
# Private files (transfer proofs) - never commit
backend/storage/
storage/
uploads/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Env
.env
*.env
venv/
backend/venv/

