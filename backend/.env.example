# ---- Environment ----
ENVIRONMENT=production

# ---- Database ----
# App connects as a NON-superuser role so Row-Level Security applies.
DATABASE_URL=postgresql+psycopg2://pos_app:CHANGE_ME_APP@127.0.0.1:5432/pos
# Migrations run as the table OWNER role.
MIGRATION_DATABASE_URL=postgresql+psycopg2://pos_owner:CHANGE_ME_OWNER@127.0.0.1:5432/pos

# ---- Auth ----
# REQUIRED in production. Generate with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Cookies ----
COOKIE_SECURE=True        # True in production (HTTPS); False only for local http
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=your-domain.sa

# ---- CORS (comma-separated; never '*') ----
CORS_ORIGINS=https://your-domain.sa

# ---- First-run bootstrap (creates the first tenant + admin) ----
BOOTSTRAP_TENANT_SLUG=bayan
BOOTSTRAP_TENANT_NAME=جمعية بيان
BOOTSTRAP_ADMIN_USERNAME=admin
# Set once to seed the admin; the admin is flagged must_change_password.
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
